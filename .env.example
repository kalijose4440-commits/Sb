DISCORD_TOKEN=replace-with-real-token
DATABASE_URL=postgresql+asyncpg://bot_user:bot_password@postgres:5432/bot_db
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
DEFAULT_PREFIX=!
DEFAULT_STATUS=online
BOT_ACTIVITY=Serving your community
ANNOUNCEMENT_POLL_SECONDS=30
PRESENCE_ROTATION_SECONDS=120
PRESENCE_TEMPLATES=["playing::Helping {guilds} guilds::online","watching::{users} members thrive::online","listening::/ticket open requests::idle","competing::Uptime {uptime}::online"]
